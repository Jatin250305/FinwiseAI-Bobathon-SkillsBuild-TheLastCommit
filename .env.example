# FinWise AI — Docker Compose Environment Variables
# Copy this file to .env and fill in real values.
# Never commit .env to version control.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=finwise
POSTGRES_PASSWORD=changeme_use_a_strong_password
POSTGRES_DB=finwise

# ── Frontend ──────────────────────────────────────────────────────────────────
# In Docker: /api is proxied by nginx to the backend — do not change.
VITE_API_BASE_URL=/api

# Get from https://console.cloud.google.com → Credentials → OAuth 2.0 Client IDs
VITE_GOOGLE_CLIENT_ID=

# Get from https://www.google.com/recaptcha/admin/create (type: v3)
VITE_RECAPTCHA_SITE_KEY=

# Port the frontend nginx listens on (host)
FRONTEND_PORT=80

# ── Backend ───────────────────────────────────────────────────────────────────
# These override backend/.env when running in Docker
ALLOWED_ORIGINS=http://localhost,http://localhost:80

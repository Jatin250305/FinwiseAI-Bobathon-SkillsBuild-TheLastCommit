# FinWise AI Backend — Environment Variables
# Copy to backend/.env and fill in real values. Never commit .env.

# ── Database ──────────────────────────────────────────────────────────────────
# This is OVERRIDDEN by docker-compose.yml in Docker.
# For local dev without Docker, use SQLite:
DATABASE_URL=sqlite:///./finwise.db

# ── JWT Auth ──────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-this-with-a-random-64-char-hex-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── CORS ──────────────────────────────────────────────────────────────────────
# For local dev: allow the Vite dev server
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80

# ── AI / LLM (optional) ───────────────────────────────────────────────────────
# If set, /ai/chat will use OpenAI GPT-4o-mini. If unset, uses rule-based fallback.
OPENAI_API_KEY=

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_NAME=FinWise AI

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Get from https://console.cloud.google.com → Credentials → OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── reCAPTCHA v3 ──────────────────────────────────────────────────────────────
# Get from https://www.google.com/recaptcha/admin/create (type: v3)
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

# ── TOTP secret encryption ────────────────────────────────────────────────────
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOTP_ENCRYPTION_KEY=

# ── SMTP — Brevo (free, 300 emails/day) ──────────────────────────────────────
# 1. Sign up at https://app.brevo.com (free)
# 2. Avatar (top-right) → SMTP & API → SMTP tab
# 3. Copy: server = smtp-relay.brevo.com, port = 587,
#          login = your Brevo account email, password = the SMTP key shown
# 4. Set SMTP_FROM to any sender address verified in Brevo
#    (your own email is fine for dev — no domain verification needed on free plan)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=                  # your Brevo account email (login)
SMTP_PASSWORD=              # the SMTP key from Brevo dashboard (starts with xsmtpib-)
SMTP_FROM=                  # e.g. your.email@gmail.com  or  noreply@yourdomain.com

# ── Auth hardening ─────────────────────────────────────────────────────────────
PASSWORD_RESET_OTP_TTL_MINUTES=10
EMAIL_VERIFY_TOKEN_TTL_HOURS=24
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
OTP_MAX_ATTEMPTS=5
